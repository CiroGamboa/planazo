# Copy to .env and fill in. Never commit .env.

# Telegram bot — user-facing surface.
TELEGRAM_BOT_TOKEN=

# LLM provider — see docs/adr/0001-agent-runtime-layout-and-provider.md.
# src/agentlib loads this one; required to run `planazo-agent`.
OPENCODE_API_KEY=

# Event sources.
# EVENTBRITE_API_TOKEN=
# MEETUP_API_TOKEN=
# INSTAGRAM_SESSION_ID=

# Google Calendar (OAuth).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Docker compose loop intervals (seconds). Both optional — compose.yaml
# supplies defaults. Only override when tuning ingestion cadence on a
# specific deployment. See ADR 0026.
# PLANAZO_SCHEDULER_INTERVAL_S=900
# PLANAZO_CURATOR_INTERVAL_S=86400

# MLflow tracking backend for HW4 tracing + eval. Optional; defaults to
# a file store under `./var/mlflow/` which the Docker `var/` bind mount
# already covers. Point at a tracking server (e.g. `http://mlflow:5000`)
# to share traces across machines. See ADR 0027.
# MLFLOW_TRACKING_URI=file:./var/mlflow
