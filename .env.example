# Copy to .env and fill in. Never commit .env.

# Telegram bot — user-facing surface.
TELEGRAM_BOT_TOKEN=

# LLM provider — see docs/adr/0001-agent-runtime-layout-and-provider.md.
# agent/src/agentlib loads this one; required to run `planazo-agent`.
OPENCODE_API_KEY=

# Event sources.
# EVENTBRITE_API_TOKEN=
# MEETUP_API_TOKEN=
# INSTAGRAM_SESSION_ID=

# Google Calendar (OAuth).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
